# Copy to .env and fill in. .env is git-ignored.

# Claude API — without a key the app runs in "no-AI" mode (templates + simple FAQ matching)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Knowledge files (swap to the real ones when the dealer sends them)
MODELS_FILE=knowledge/models.dummy.yaml
BUSINESS_FILE=knowledge/business.dummy.yaml

# Calendar: "mock" (local JSON in data/) or "google"
CALENDAR_PROVIDER=mock
GOOGLE_CALENDAR_ID=primary
# OAuth client file downloaded from Google Cloud Console (Desktop app)
GOOGLE_CREDENTIALS_FILE=data/credentials.json
GOOGLE_TOKEN_FILE=data/token.json

# Where the SQLite DB lives (git-ignored)
DB_PATH=data/leads.db

PORT=5050

# ---- Conversation ----------------------------------------------------------
# wame      = phase 1: human sends every message from WhatsApp via a wa.me link
# simulator = test the agent end to end at /simulator (you play the customer)
# cloud     = WhatsApp Business Cloud API (official, real customers)
CHANNEL=simulator
# supervised = the agent drafts, a human approves each reply in the UI
# auto       = the agent replies and books meetings by itself
AGENT_MODE=supervised
# Wait N seconds after a customer message before answering (they often send 2-3 in a row). 0 = immediately.
DEBOUNCE_SECONDS=0
# Salesperson's number for alerts (e.g. 972501234567). Best effort — see README.
NOTIFY_PHONE=

# ---- WhatsApp Business Cloud API (CHANNEL=cloud) ---------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Approved template for the first message. Body params: {{1}} first name, {{2}} model.
WHATSAPP_OPENING_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=he
